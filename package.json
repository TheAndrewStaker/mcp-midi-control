    "agent-sweep:am4": "tsx scripts/agent-regression/index.ts --device=am4",
    "agent-sweep:axefx2": "tsx scripts/agent-regression/index.ts --device=axe-fx-ii",
    "agent-sweep:axefx3": "tsx scripts/agent-regression/index.ts --device=axe-fx-iii",
    "agent-sweep:hydra": "tsx scripts/agent-regression/index.ts --device=hydrasynth",
    "agent-sweep:real": "tsx scripts/agent-regression/index.ts --real-hardware",
