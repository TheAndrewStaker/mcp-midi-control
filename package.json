    "test:axe-fx-ii": "npm run verify-axe-fx-ii-encoding && npm run verify-axe-fx-ii-param-lookup && npm run verify-axe-fx-ii-lineage && npm run verify-axe-fx-ii-routing && npm run verify-axe-fx-ii-display-units && npm run verify-axe-fx-ii-calibration",
    "test:axe-fx-iii": "npm run verify-axe-fx-iii-encoding && npm run verify-preset-dump-iii",
    "test:hydra": "npm run hydra:verify-encoding && npm run hydra:verify-sysex-envelope && npm run hydra:verify-sysex-patch && npm run hydra:verify-init-buffer && npm run hydra:test-patch-name && npm run hydra:verify-enum-mapping && npm run hydra:verify-nrpn-display",
    "test:server": "npm run smoke-server && npm run build && npm run verify-lineage-resources && npm run verify-agent-retry-paths && npm run verify-tool-annotations",
    "verify-agent-retry-paths": "tsx scripts/mcp-test-agent-retry-paths.ts",
    "live-regression": "tsx scripts/live-regression.ts",
    "analyze-logs": "tsx scripts/analyze-mcp-logs.ts",
    "verify-tool-annotations": "tsx scripts/mcp-test-tool-annotations.ts",
    "test": "npm run test:codec && npm run test:cross-device && npm run test:axe-fx-ii && npm run test:axe-fx-iii && npm run test:hydra && npm run test:server",
    "test:jest": "jest --testPathIgnorePatterns=integration",
    "test:jest:all": "jest",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/am4/tsconfig.json && tsc --noEmit -p packages/axe-fx-ii/tsconfig.json && tsc --noEmit -p packages/axe-fx-iii/tsconfig.json && tsc --noEmit -p packages/hydrasynth/tsconfig.json && tsc --noEmit -p packages/server-all/tsconfig.json",
    "tools:inventory": "tsx scripts/list-tools.ts",
    "tools:inventory-check": "tsx scripts/list-tools.ts --check",
    "preflight": "npm run typecheck && npm test && npm run verify-no-internal-refs && npm run coverage-audit && npm run cookbook-verify && npm run tools:inventory-check",
    "release-gate": "npm run preflight && npm run launch-verify && npm run agent-sweep && npm run live-regression"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "adm-zip": "^0.5.17",
    "fractal-midi": "file:../fractal-midi/fractal-midi-0.1.0-alpha.7.tgz",
    "jest": "^29.0.0",
    "midi": "^2.0.0",
    "ts-jest": "^29.0.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "zod": "^4.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
