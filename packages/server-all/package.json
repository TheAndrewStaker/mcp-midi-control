{
  "name": "@mcp-midi-control/server-all",
  "version": "0.9.0",
  "description": "MCP server entry point composing all device packages.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/server/index.js",
  "exports": {
    "./*": "./dist/*"
  },
  "dependencies": {
    "@mcp-midi-control/am4": "*",
    "@mcp-midi-control/fractal-gen1": "*",
    "@mcp-midi-control/fractal-gen2": "*",
    "@mcp-midi-control/core": "*",
    "@mcp-midi-control/fractal-gen3": "*",
    "@mcp-midi-control/hydrasynth": "*",
    "@mcp-midi-control/circuit-tracks": "*",
    "@mcp-midi-control/spd-sx": "*",
    "@mcp-midi-control/arturia": "*",
    "@mcp-midi-control/ve-500": "*",
    "@mcp-midi-control/boss-rc": "*",
    "@mcp-midi-control/akai-mpc": "*",
    "@mcp-midi-control/rig-console-render": "*",
    "openrig": "*",
    "@modelcontextprotocol/server": "^2.0.0",
    "fractal-midi": "*",
    "@julusian/midi": "^3.6.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "npm run build:webapp && tsc -p tsconfig.json",
    "build:webapp": "esbuild src/server/webapp-client/rig-console-app.ts --bundle --format=esm --target=es2022 --outfile=dist/webapp-client/rig-console-app.js"
  }
}
